# Template for Config/secrets.properties, which is NOT committed.
#
# Copy this file to secrets.properties in the same folder and fill in the values you need.
# Everything in it is optional: a run with no secrets.properties at all works exactly as it
# does today, because nothing in the suites requires any of these.
#
# It is read after config.properties and wins over it, so a value put here quietly replaces
# the committed one. That is the intended use for the account settings below: point your own
# machine at your own account without producing a change to config.properties that you then
# have to remember not to commit.
#
# ORDER OF PRECEDENCE, highest first
#
#   1. -Dkey=value on the command line
#   2. the environment variable (MAIL_PASSWORD, TEST_PASSWORD, ...)
#   3. this file
#   4. Config/config.properties
#
# An environment variable still wins over this file, so setting one for CI does not clash with
# having this on a developer machine.


# --- Emailing the report when a run finishes ---
#
# Set mail.enabled=true in config.properties (or pass -Dmail.enabled=true) and put an app
# password here. The run then sends the tally and the client HTML report when it finishes.
#
# Where to get the password: https://myaccount.google.com/apppasswords - a Google account
# password will not work, it has to be an app password. Google shows it in four groups of
# four; paste it either way, the spaces are ignored.

mail.password=xxxx xxxx xxxx xxxx

# Who it comes from and who it goes to. Usually the same mailbox the app password belongs to.
# A comma-separated list is accepted for mail.to.
#mail.from=you@example.com
#mail.to=you@example.com


# --- Accounts, if yours differ from the committed ones ---
#
# Uncomment only what you actually change. Anything left commented falls through to
# config.properties, which is where the shared QA accounts are.

#test.username=
#test.password=
#test.alt.username=
#test.alt.password=
